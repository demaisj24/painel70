{
  "name": "Painel 70 - Laboratorio",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Previa privada do Painel 70",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "postStartCommand": "nohup python3 -m http.server 8000 > /tmp/painel70-http.log 2>&1 &"
}
